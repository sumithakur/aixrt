{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "AIX Summit 2026 Official Brand Guidelines Tokens",
  "version": "2.0.0",
  "color": {
    "bg": {
      "base": "#160C35",
      "raised": "#2B204C",
      "surface": "#1F173B",
      "overlay": "rgba(22, 12, 53, 0.90)"
    },
    "text": {
      "primary": "#FFFFFF",
      "secondary": "#A0A0B4",
      "muted": "#7A7A92",
      "inverse": "#160C35"
    },
    "brand": {
      "primary": "#F746A9",
      "primaryHover": "#FF5EBA",
      "secondary": "#3DD8D8",
      "secondaryHover": "#5FE8E8",
      "neonFuchsia": "#F746A9",
      "brightAqua": "#3DD8D8",
      "mediumSlateBlue": "#8B68F6",
      "electricLilac": "#BF5CF4",
      "indigoPurple": "#2B204C",
      "slateBlue": "#7356CB",
      "amethystPurple": "#9E4CC9",
      "deepMagenta": "#CD3A8C",
      "brightTeal": "#31AEAE"
    },
    "border": {
      "subtle": "rgba(255, 255, 255, 0.12)",
      "prominent": "rgba(255, 255, 255, 0.25)",
      "highlight": "rgba(247, 70, 169, 0.45)"
    },
    "accent": {
      "fintech": "#3DD8D8",
      "industrial": "#8B68F6",
      "cybersecurity": "#31AEAE",
      "state": "#BF5CF4",
      "agentic": "#F746A9"
    },
    "status": {
      "confirmed": "#10B981",
      "pending": "#F59E0B"
    }
  },
  "gradient": {
    "hero": "linear-gradient(to right, #F746A9, #3DD8D8)",
    "brand": "linear-gradient(to right, #F746A9, #3DD8D8)",
    "aquaToFuchsia": "linear-gradient(to right, #3DD8D8, #F746A9)",
    "text": "linear-gradient(to right, #FFFFFF, #F746A9, #8B68F6)",
    "surface": "linear-gradient(180deg, #2B204C 0%, #160C35 100%)",
    "glow": "radial-gradient(circle at 50% 0%, rgba(247, 70, 169, 0.25) 0%, rgba(22, 12, 53, 0) 70%)"
  },
  "font": {
    "display": "var(--font-montserrat), Montserrat, sans-serif",
    "body": "var(--font-inter), Inter, sans-serif"
  },
  "radius": {
    "none": "0px",
    "sm": "6px",
    "md": "12px",
    "lg": "20px",
    "pill": "9999px"
  },
  "shadow": {
    "card": "0 4px 20px rgba(0, 0, 0, 0.4)",
    "raised": "0 16px 40px rgba(247, 70, 169, 0.25)",
    "glow": "0 0 35px rgba(247, 70, 169, 0.35)",
    "focus": "0 0 0 2px #F746A9"
  },
  "motion": {
    "duration": {
      "fast": "150ms",
      "base": "300ms",
      "slow": "500ms"
    },
    "ease": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)"
    }
  }
}
