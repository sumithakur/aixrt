# Copy to .env.local for local development, and set the same values as
# environment variables on the deployment (Vercel → Settings → Environment Variables).
# .env.local is git-ignored; never commit real values.

# --- Firebase (required: without it the CMS cannot store an edit) ---
# A save that does not reach Firebase is written only to the server's temporary
# disk and is discarded on the next deployment. The CMS banner reports this.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The whole key in one line, wrapped in double quotes, with \n between lines —
# exactly as the downloaded service-account JSON contains it.
FIREBASE_PRIVATE_KEY=""

# --- CMS sign-in ---
# Defaults exist in the code for local use; set real values on any deployment.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string. Changing it signs every admin session out.
ADMIN_AUTH_SECRET=

# --- Links ---
NEXT_PUBLIC_REGISTER_URL=
NEXT_PUBLIC_API_BASE_URL=
